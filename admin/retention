# Trims per-RunDate log run indexes and the global event journal (see spec 0009).
#
# No EnvVar here: BORG_COOKIE must come from the agent's own process environment, not a
# hardcoded override — see admin/load_next_rundate's own comment for why.
Master: any
Command: borg admin retention
Host: any
Days: d
DependsOn: admin/retire_rundates
Timeout: 300
RepeatCount: 3
